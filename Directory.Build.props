<Project>
  <!--
    OpenHW's version, shared by the app, the helper and the tests. Semantic versioning while pre-1.0:
    bump MINOR for a round of new features (0.3.0), PATCH for fixes only (0.2.1); 1.0.0 is the owner's call.
    Each release gets a CHANGELOG.md entry and a git tag (v0.2.0). The app stamps the git revision after a "+".
  -->
  <PropertyGroup>
    <Version>0.14.0</Version>
  </PropertyGroup>
</Project>
