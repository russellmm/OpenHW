<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenHW.App</RootNamespace>
    <AssemblyName>openhw</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same Avalonia as openfan-linux: it pins Tmds.DBus.Protocol 0.20, which the tray code and the shared
         hardware layer both use. Upgrade the three together, never one alone. -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sensor reading is shared with openfan-linux rather than copied (libsensors, NVML, HSMP, NVMe, EDAC). -->
    <ProjectReference Include="..\..\..\..\ChatGPT\openfan-linux\src\OpenFan.Core\OpenFan.Core.csproj" />
    <ProjectReference Include="..\..\..\..\ChatGPT\openfan-linux\src\OpenFan.Linux.Hw\OpenFan.Linux.Hw.csproj" />
  </ItemGroup>

</Project>
