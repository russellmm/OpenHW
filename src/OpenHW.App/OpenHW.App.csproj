<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenHW.App</RootNamespace>
    <AssemblyName>openhw</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 11.2 pins Tmds.DBus.Protocol 0.20, which the tray code also uses. Upgrade them together. -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenHW.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenHW.Hardware\OpenHW.Hardware.csproj" />
  </ItemGroup>

  <!-- Stamp the git revision into InformationalVersion ("0.1.0+b8d3adf", "-dirty" with uncommitted changes) so the
       window footer shows exactly which build is running. Builds outside a git checkout keep the plain version. -->
  <Target Name="StampGitRevision" BeforeTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; describe --always --dirty --abbrev=7" ConsoleToMSBuild="true"
          StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitExitCode)' != '0'">
      <SourceRevisionId />
    </PropertyGroup>
  </Target>

</Project>
