<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenHW.App</RootNamespace>
    <AssemblyName>openhw</AssemblyName>
    <!-- Memory (measured 2026-10-24, window open, 90 s median): PGO's instrumented tier costs ~7 MB for no visible
         gain in a 2 s poll loop. See Program.Gen0Budget for the GC's allocation budget. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the GC compact harder to keep the heap small (~6 MB here); 7 of 9 is a moderate setting. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia 11.2 pins Tmds.DBus.Protocol 0.20, which the tray code also uses. Upgrade them together. -->
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.20.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenHW.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenHW.Hardware\OpenHW.Hardware.csproj" />
  </ItemGroup>

  <!-- Stamp the git revision into InformationalVersion ("0.2.0+b8d3adf", "-dirty" with uncommitted changes; tags are
       ignored so a tagged commit still shows its hash) so the
       window footer shows exactly which build is running. Builds outside a git checkout keep the plain version. -->
  <Target Name="StampGitRevision" BeforeTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; describe --always --dirty --abbrev=7 --exclude=*" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitExitCode)' != '0'">
      <SourceRevisionId />
    </PropertyGroup>
  </Target>

</Project>
