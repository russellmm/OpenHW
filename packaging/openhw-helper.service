[Unit]
Description=OpenHW privileged helper (NVMe SMART, CPU frequency caps, GPU and CPU power limits)
Documentation=https://github.com/russellmm/OpenHW

[Service]
Type=simple
ExecStart=/usr/local/lib/openhw/openhw-helper
# /run/openhw is created on start and removed on stop; the socket inside is 0660 root:openhw.
RuntimeDirectory=openhw
Restart=on-failure
RestartSec=2

# It needs the NVMe admin ioctl (CAP_SYS_ADMIN), to hand its socket to the group, and two writable sysfs trees, both
# root-owned 0644 (so no DAC override): cpufreq's scaling_max_freq, and amd_hsmp_hwmon's power1_cap under the HSMP
# platform device. GPU power limits go through NVML, which opens the NVIDIA control and card devices.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/sys/devices/system/cpu
ReadWritePaths=-/sys/devices/platform
# Boot-time limits live in the owner's boot services' config: hsmp-control's ppt_mw, and OpenHW's own drop-in for
# nvidia-power-limit.service (install-helper.sh creates that directory; the unit file itself is never written).
ReadWritePaths=-/etc/hsmp-control
ReadWritePaths=-/etc/systemd/system/nvidia-power-limit.service.d
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
DevicePolicy=closed
DeviceAllow=char-nvme r
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
