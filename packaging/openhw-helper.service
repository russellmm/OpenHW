[Unit]
Description=OpenHW privileged helper (NVMe SMART, CPU frequency ceiling restore)
Documentation=https://github.com/russellmm/OpenHW

[Service]
Type=simple
ExecStart=/usr/local/lib/openhw/openhw-helper
# /run/openhw is created on start and removed on stop; the socket inside is 0660 root:openhw.
RuntimeDirectory=openhw
Restart=on-failure
RestartSec=2

# It needs the NVMe admin ioctl (CAP_SYS_ADMIN), to hand its socket to the group, and one writable sysfs tree:
# cpufreq's scaling_max_freq (root-owned 0644, so no DAC override), to undo the base-clock clamp power-saver leaves.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/sys/devices/system/cpu
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
DevicePolicy=closed
DeviceAllow=char-nvme r
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
