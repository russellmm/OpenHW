[Unit]
Description=OpenHW privileged helper (NVMe SMART, DIMM and VR sensors, CPU frequency caps, GPU and CPU power limits)
Documentation=https://github.com/russellmm/OpenHW
# With GPU Lending installed, the card filter must be in force before the login screen and the desktop can open the
# lent card: the helper writes a drop-in (openhw-helper.service.d/lending.conf) that orders it before them, and
# removes it on uninstall. With the filter off it's ready at once; with it on, it waits (≤60 s) for the card's nodes.
After=systemd-modules-load.service nvidia-persistenced.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90
ExecStart=/usr/local/lib/openhw/openhw-helper
# /run/openhw is created on start and removed on stop; the socket inside is 0660 root:openhw.
RuntimeDirectory=openhw
# Kept across stop/start (until reboot): the card filter's "hide now" list lives here, and RTXinVM's switch stops
# and starts this service around a Windows start.
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=2

# It needs the NVMe admin ioctl (CAP_SYS_ADMIN), to hand its socket to the group, and two writable sysfs trees, both
# root-owned 0644 (so no DAC override): cpufreq's scaling_max_freq, and amd_hsmp_hwmon's power1_cap under the HSMP
# platform device. GPU power limits go through NVML, which opens the NVIDIA control and card devices. The card filter
# loads an eBPF cgroup device program (CAP_BPF) and attaches it to user.slice (CAP_NET_ADMIN for cgroup attach), and
# lists which processes have the lent card open: listing another user's /proc/<pid>/fd (0500) needs
# CAP_DAC_READ_SEARCH, and reading its links needs CAP_SYS_PTRACE.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_BPF CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/sys/devices/system/cpu
ReadWritePaths=-/sys/devices/platform
# Boot-time limits live in the owner's boot services' config: hsmp-control's ppt_mw, and OpenHW's own drop-in for
# nvidia-power-limit.service (install-helper.sh creates that directory; the unit file itself is never written).
ReadWritePaths=-/etc/hsmp-control
ReadWritePaths=-/etc/systemd/system/nvidia-power-limit.service.d
# Card filter: its list (/etc/openhw) and its pinned eBPF program and maps (bpffs). Attaching needs only an open
# cgroup directory, which ProtectControlGroups' read-only mount allows.
ReadWritePaths=-/etc/openhw
ReadWritePaths=/sys/fs/bpf
# GPU Lending's install/uninstall (page → Install / Uninstall): only fixed file names in these folders — its boot-order
# drop-in for this unit, its udev rule (61-openhw-lending.rules, replacing RTXinVM's 61-windows-gpu.rules) and the
# libvirt handoff hook (qemu.d/50-windows-gpu, moved to /etc/openhw/lending-off/ and back).
ReadWritePaths=-/etc/systemd/system/openhw-helper.service.d
ReadWritePaths=-/etc/udev/rules.d
ReadWritePaths=-/etc/libvirt/hooks/qemu.d
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
# Not ProtectKernelTunables: it makes all of /sys read-only, and bpffs (/sys/fs/bpf, where the card filter pins its
# program) can't be made writable again under it (tools/sandbox-bpffs-test.sh, 2026-10-26: RO with ReadWritePaths or
# BindPaths, RW only without it). The tunables it protects are made read-only here instead.
ReadOnlyPaths=/proc/sys /proc/sysrq-trigger /proc/acpi /proc/irq /proc/fs
ReadOnlyPaths=/sys/kernel /sys/module /sys/power /sys/firmware
ProtectKernelModules=true
ProtectControlGroups=true
DevicePolicy=closed
DeviceAllow=char-nvme r
DeviceAllow=char-nvidia rw
DeviceAllow=char-nvidiactl rw
# DDR5 DIMM thermal sensors/PMICs and the board's PMBus VR, through /dev/i2c-N (reads, and the PMIC ADC select).
DeviceAllow=char-i2c rw
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
